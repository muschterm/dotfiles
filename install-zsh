#!/usr/bin/env zsh

dotfiles_dir="${0:a:h}"

. "$dotfiles_dir/scripts/install-lib.sh"

df-install-banner

if [ ! -z "$DOCKER_IMAGE_NAME" ]; then
	ln -snf "$dotfiles_dir/sh/zsh/rc.sh" "/etc/profile.d/dotfiles.zshrc.sh"
elif [ "$(uname -s)" = "Linux" ] || [ "$(uname -s)" = "Darwin" ]; then

	if [ ! -f "$HOME/.zprofile" ]; then
		touch "$HOME/.zprofile"
	fi

	# the pre-rename installs wrote bare, unmarked lines - drop them so the
	# upgrade does not leave a line pointing at a file that no longer exists
	for df_legacy in "$HOME/.zshenv" "$HOME/.zshrc"; do
		if [ -f "$df_legacy" ]; then
			mv "$df_legacy" "$df_legacy.bak"
			sed -e "/\.dotfiles\.env/d" -e "/\.dotfiles\.zsh/d" -e "/\.dfzsh/d" \
				"$df_legacy.bak" >"$df_legacy"
		fi
	done
	unset df_legacy

	# .zshenv is read by every zsh, interactive or not, so the DF_SETUP_* flags
	# in .dfenv are in scope everywhere - not just where rc.sh runs
	df-install-block "$HOME/.zshenv" <<-HERE
		[ -f "\$HOME/.dfenv" ] && . "\$HOME/.dfenv"
	HERE

	df-install-block "$HOME/.zshrc" <<-HERE
		[ -f "\$HOME/.dfrc" ] && . "\$HOME/.dfrc"
	HERE

	. "$dotfiles_dir/scripts/install-common.sh"

	df-install-updated "$HOME/.zshenv" "$HOME/.zshrc" "$HOME/.dfrc"
fi

df-install-finished
